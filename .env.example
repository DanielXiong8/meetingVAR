# Copy to .env and fill the three LLM settings. Never commit the filled .env.
# Base URL only: the application appends /chat/completions automatically.
MEETINGVAR_LLM_BASE_URL=
MEETINGVAR_LLM_API_KEY=
MEETINGVAR_LLM_MODEL=

# Optional local model directory; leave commented to use the current default.
# MEETINGVAR_MODELS=D:/env/models
# MEETINGVAR_ASR=SenseVoiceSmall
